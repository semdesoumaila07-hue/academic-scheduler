"""
Onglet de gestion de la structure universitaire.
"""
from PyQt5.QtWidgets import (
    QWidget, QVBoxLayout, QHBoxLayout, QPushButton, QTableWidget,
    QTableWidgetItem, QHeaderView, QLabel, QFrame, QTabWidget
)
from PyQt5.QtCore import Qt
from PyQt5.QtGui import QIcon


class StructureTab(QWidget):
    """Onglet pour gérer la structure universitaire."""
    
    def __init__(self, parent=None):
        super().__init__(parent)
        self.init_ui()
    
    def init_ui(self):
        """Initialise l'interface."""
        layout = QVBoxLayout(self)
        layout.setContentsMargins(30, 30, 30, 30)
        layout.setSpacing(20)
        
        # En-tête
        header_layout = QVBoxLayout()
        title = QLabel("Structure Universitaire")
        title.setStyleSheet("font-size: 32px; font-weight: bold; color: #1a1a1a;")
        header_layout.addWidget(title)
        
        subtitle = QLabel("Gérez les universités, UFR, programmes et cohortes")
        subtitle.setStyleSheet("font-size: 16px; color: #666;")
        header_layout.addWidget(subtitle)
        
        layout.addLayout(header_layout)
        
        # Onglets pour chaque niveau
        tabs = QTabWidget()
        tabs.setStyleSheet("""
            QTabWidget::pane {
                border: 1px solid #E0E0E0;
                border-radius: 8px;
                background: white;
                padding: 20px;
            }
            QTabBar::tab {
                padding: 12px 24px;
                margin-right: 5px;
                background: #F5F5F5;
                border-top-left-radius: 8px;
                border-top-right-radius: 8px;
            }
            QTabBar::tab:selected {
                background: white;
                border-bottom: 2px solid #2196F3;
            }
        """)
        
        # Tab Universités
        univ_tab = self.create_universities_tab()
        tabs.addTab(univ_tab, "🎓 Universités")
        
        # Tab UFR
        ufr_tab = self.create_ufr_tab()
        tabs.addTab(ufr_tab, "🏛️ UFR")
        
        # Tab Programmes
        prog_tab = self.create_programs_tab()
        tabs.addTab(prog_tab, "📚 Programmes")
        
        # Tab Cohortes
        cohort_tab = self.create_cohorts_tab()
        tabs.addTab(cohort_tab, "👥 Cohortes")
        
        layout.addWidget(tabs)

        def __init__(self, parent=None):
    super().__init__(parent)
    
    # Données en mémoire (temporaire - à remplacer par BD plus tard)
    self.universities = [
        {'id': 1, 'name': 'Université Thomas Sankara', 'code': 'UTS', 'city': 'Ouagadougou', 'country': 'Burkina Faso'},
        {'id': 2, 'name': 'Université Norbert Zongo', 'code': 'UNZ', 'city': 'Koudougou', 'country': 'Burkina Faso'},
    ]
    self.next_id = 3
    
    self.init_ui()

def load_universities(self):
    """Charge les universités dans la table."""
    self.universities_table.setRowCount(len(self.universities))
    
    for i, univ in enumerate(self.universities):
        self.universities_table.setItem(i, 0, QTableWidgetItem(str(univ['id'])))
        self.universities_table.setItem(i, 1, QTableWidgetItem(univ['name']))
        self.universities_table.setItem(i, 2, QTableWidgetItem(univ['code']))
        self.universities_table.setItem(i, 3, QTableWidgetItem(univ['city']))
        self.universities_table.setItem(i, 4, QTableWidgetItem(univ['country']))
        
        # Boutons d'action
        actions_widget = self.create_action_buttons_with_data(i)
        self.universities_table.setCellWidget(i, 5, actions_widget)

def create_action_buttons_with_data(self, row_index):
    """Crée les boutons d'action avec connexion."""
    widget = QWidget()
    layout = QHBoxLayout(widget)
    layout.setContentsMargins(0, 0, 0, 0)
    layout.setSpacing(10)
    
    # Bouton éditer
    btn_edit = QPushButton("✏️")
    btn_edit.setStyleSheet("""
        QPushButton {
            background: transparent;
            border: none;
            font-size: 18px;
            padding: 5px;
        }
        QPushButton:hover {
            background-color: #F3F4F6;
            border-radius: 4px;
        }
    """)
    btn_edit.setCursor(Qt.PointingHandCursor)
    btn_edit.setFixedSize(35, 35)
    btn_edit.clicked.connect(lambda: self.edit_university(row_index))
    
    # Bouton supprimer
    btn_delete = QPushButton("🗑️")
    btn_delete.setStyleSheet("""
        QPushButton {
            background: transparent;
            border: none;
            font-size: 18px;
            padding: 5px;
            color: #EF4444;
        }
        QPushButton:hover {
            background-color: #FEE2E2;
            border-radius: 4px;
        }
    """)
    btn_delete.setCursor(Qt.PointingHandCursor)
    btn_delete.setFixedSize(35, 35)
    btn_delete.clicked.connect(lambda: self.delete_university(row_index))
    
    layout.addWidget(btn_edit)
    layout.addWidget(btn_delete)
    layout.addStretch()
    
    return widget

def add_university(self):
    """Ajoute une nouvelle université."""
    from ..dialogs import UniversityDialog
    
    dialog = UniversityDialog(self)
    
    if dialog.exec_() == QDialog.Accepted:
        data = dialog.get_data()
        if data:
            # Ajouter à la liste
            data['id'] = self.next_id
            self.next_id += 1
            self.universities.append(data)
            
            # Recharger la table
            self.load_universities()
            
            # Message de succès
            QMessageBox.information(self, "Succès", "Université ajoutée avec succès !")

def edit_university(self, row_index):
    """Modifie une université."""
    from ..dialogs import UniversityDialog
    
    if row_index < len(self.universities):
        univ_data = self.universities[row_index]
        
        dialog = UniversityDialog(self, univ_data)
        
        if dialog.exec_() == QDialog.Accepted:
            data = dialog.get_data()
            if data:
                # Mettre à jour
                data['id'] = univ_data['id']  # Garder le même ID
                self.universities[row_index] = data
                
                # Recharger
                self.load_universities()
                
                QMessageBox.information(self, "Succès", "Université modifiée avec succès !")

def delete_university(self, row_index):
    """Supprime une université."""
    if row_index < len(self.universities):
        univ = self.universities[row_index]
        
        # Confirmation
        reply = QMessageBox.question(
            self,
            "Confirmer la suppression",
            f"Voulez-vous vraiment supprimer l'université '{univ['name']}' ?\n\nCette action est irréversible.",
            QMessageBox.Yes | QMessageBox.No,
            QMessageBox.No
        )
        
        if reply == QMessageBox.Yes:
            # Supprimer
            del self.universities[row_index]
            
            # Recharger
            self.load_universities()
            
            QMessageBox.information(self, "Succès", "Université supprimée avec succès !")

def get_add_button_style(self):
    """Style du bouton Ajouter."""
    return """
        QPushButton {
            background-color: #000;
            color: white;
            border: none;
            border-radius: 6px;
            padding: 10px 24px;
            font-size: 14px;
            font-weight: 500;
        }
        QPushButton:hover {
            background-color: #333;
        }
    """
    
    def create_universities_tab(self):

    widget = QWidget()
    layout = QVBoxLayout(widget)
    layout.setContentsMargins(0, 0, 0, 0)
    
    # En-tête avec bouton
    header = QHBoxLayout()
    header_label = QLabel(f"Universités ({len(self.universities)})")
    header_label.setStyleSheet("font-size: 16px; font-weight: 600;")
    
    btn_add = QPushButton("+ Ajouter")
    btn_add.setStyleSheet(self.get_add_button_style())
    btn_add.setCursor(Qt.PointingHandCursor)
    btn_add.clicked.connect(self.add_university)  # ← CONNEXION ICI
    
    header.addWidget(header_label)
    header.addStretch()
    header.addWidget(btn_add)
    
    layout.addLayout(header)
    layout.addSpacing(20)
    
    # Table
    self.universities_table = QTableWidget()
    self.universities_table.setColumnCount(6)
    self.universities_table.setHorizontalHeaderLabels(["ID", "Nom", "Code", "Ville", "Pays", "Actions"])
    self.universities_table.horizontalHeader().setSectionResizeMode(QHeaderView.Stretch)
    self.universities_table.horizontalHeader().setSectionResizeMode(5, QHeaderView.Fixed)
    self.universities_table.setColumnWidth(5, 120)
    self.universities_table.setStyleSheet(self.get_modern_table_style())
    
    # Charger les données
    self.load_universities()
    
    layout.addWidget(self.universities_table)
    
    return widget
    
    def create_ufr_tab(self):
        """Crée l'onglet des UFR."""
        widget = QWidget()
        layout = QVBoxLayout(widget)
        
        # Boutons
        btn_layout = QHBoxLayout()
        btn_add = QPushButton("➕ Nouvelle UFR")
        btn_add.setStyleSheet(self.get_button_style("#4CAF50"))
        btn_add.setFixedHeight(40)
        btn_layout.addWidget(btn_add)
        btn_layout.addStretch()
        layout.addLayout(btn_layout)
        
        # Table
        table = QTableWidget()
        table.setColumnCount(4)
        table.setHorizontalHeaderLabels(["ID", "Nom", "Code", "Université"])
        table.horizontalHeader().setSectionResizeMode(QHeaderView.Stretch)
        table.setStyleSheet(self.get_table_style())
        
        table.setRowCount(3)
        table.setItem(0, 0, QTableWidgetItem("1"))
        table.setItem(0, 1, QTableWidgetItem("UFR Sciences Exactes et Appliquées"))
        table.setItem(0, 2, QTableWidgetItem("UFR-SEA"))
        table.setItem(0, 3, QTableWidgetItem("Université Thomas Sankara"))
        
        layout.addWidget(table)
        
        return widget
    
    def create_programs_tab(self):
        """Crée l'onglet des programmes."""
        widget = QWidget()
        layout = QVBoxLayout(widget)
        
        # Boutons
        btn_layout = QHBoxLayout()
        btn_add = QPushButton("➕ Nouveau Programme")
        btn_add.setStyleSheet(self.get_button_style("#4CAF50"))
        btn_add.setFixedHeight(40)
        btn_layout.addWidget(btn_add)
        btn_layout.addStretch()
        layout.addLayout(btn_layout)
        
        # Table
        table = QTableWidget()
        table.setColumnCount(5)
        table.setHorizontalHeaderLabels(["ID", "Nom", "Code", "Niveau", "UFR"])
        table.horizontalHeader().setSectionResizeMode(QHeaderView.Stretch)
        table.setStyleSheet(self.get_table_style())
        
        layout.addWidget(table)
        
        return widget
    
    def create_cohorts_tab(self):
        """Crée l'onglet des cohortes."""
        widget = QWidget()
        layout = QVBoxLayout(widget)
        
        # Boutons
        btn_layout = QHBoxLayout()
        btn_add = QPushButton("➕ Nouvelle Cohorte")
        btn_add.setStyleSheet(self.get_button_style("#4CAF50"))
        btn_add.setFixedHeight(40)
        btn_layout.addWidget(btn_add)
        btn_layout.addStretch()
        layout.addLayout(btn_layout)
        
        # Table
        table = QTableWidget()
        table.setColumnCount(6)
        table.setHorizontalHeaderLabels([
            "ID", "Nom", "Année", "Semestre", "Étudiants", "Programme"
        ])
        table.horizontalHeader().setSectionResizeMode(QHeaderView.Stretch)
        table.setStyleSheet(self.get_table_style())
        
        table.setRowCount(4)
        table.setItem(0, 0, QTableWidgetItem("1"))
        table.setItem(0, 1, QTableWidgetItem("L3 Info 2025-2026"))
        table.setItem(0, 2, QTableWidgetItem("2025-2026"))
        table.setItem(0, 3, QTableWidgetItem("1"))
        table.setItem(0, 4, QTableWidgetItem("45"))
        table.setItem(0, 5, QTableWidgetItem("Licence Informatique"))
        
        layout.addWidget(table)
        
        return widget
    
    def get_button_style(self, color):
        """Retourne le style des boutons."""
        return f"""
            QPushButton {{
                background-color: {color};
                color: white;
                border: none;
                border-radius: 8px;
                padding: 10px 20px;
                font-size: 14px;
                font-weight: bold;
            }}
            QPushButton:hover {{
                background-color: {self.darken_color(color)};
            }}
        """
    
    def get_table_style(self):
        """Retourne le style des tables."""
        return """
            QTableWidget {
                border: 1px solid #E0E0E0;
                border-radius: 8px;
                background-color: white;
                gridline-color: #F0F0F0;
            }
            QTableWidget::item {
                padding: 10px;
            }
            QHeaderView::section {
                background-color: #F5F5F5;
                padding: 12px;
                border: none;
                font-weight: bold;
                color: #333;
            }
        """
    
    def darken_color(self, color):
        """Assombrit une couleur pour l'effet hover."""
        # Simple darkening
        colors = {
            "#4CAF50": "#388E3C",
            "#2196F3": "#1976D2",
            "#F44336": "#D32F2F",
        }
        return colors.get(color, color)